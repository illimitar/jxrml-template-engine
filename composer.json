{
    "name": "a2insights/jxrml-template-engine",
    "description": "Framework-agnostic JRXML template rendering engine.",
    "keywords": [
        "package",
        "template engine",
        "jxrml"
    ],
    "homepage": "https://github.com/a2insights/jxrml-template-engine",
    "license": "MIT",
    "authors": [
        {
            "name": "a21ns1g4ts",
            "email": "atila.danvi@outlook.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "quilhasoft/jasperphp": "dev-master"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "A2Insights\\JxrmlTemplateEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "A2Insights\\JxrmlTemplateEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
